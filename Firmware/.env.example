# Copy to .env and fill in your own values:  cp .env.example .env
# Find site IDs at https://transport.integration.sl.se/v1/sites

# train_bus: commuter rail + bus
# train_bus_metro: commuter rail + bus + metro
DISPLAY_MODE=train_bus_metro

PENDELTAG_SITE_ID=9117
BUS_STOP_ID=9117
BUS_LINE=50
METRO_SITE_ID=9117
METRO_LINES=17,18,19

STATION_NAME=Odenplan
BUS_STOP_NAME=Odenplan

DATA_FILE=/tmp/transport_data.json
# Optional, set if your username isn't displegory
# EPD_LIB_PATH=/home/displegory/e-Paper/RaspberryPi_JetsonNano/python/lib
